#!/usr/bin/env bash
#
# sudo-timer — passwordless sudo for a length of time you pick.
#
#   sudo-timer              pick a duration from a menu
#   sudo-timer 15m          enable for 15 minutes
#   sudo-timer 6h           enable for 6 hours
#   sudo-timer lock         enable until the screen locks (or reboot)
#   sudo-timer reboot       enable until the next reboot
#   sudo-timer forever      enable until you turn it off
#   sudo-timer status       show mode and time left
#   sudo-timer off          revoke now
#
# The rule is a drop-in in /etc/sudoers.d. Everything except "forever" is named
# 99-sudo-timer-* so the boot cleanup unit deletes it, which is what makes
# "reboot" work and what keeps "lock" from outliving a crash of its watcher.

set -euo pipefail

USER_NAME=${SUDO_USER:-$USER}

TIMED_FILE="/etc/sudoers.d/99-sudo-timer-${USER_NAME}"
REBOOT_FILE="/etc/sudoers.d/99-sudo-timer-${USER_NAME}-reboot"
LOCK_FILE="/etc/sudoers.d/99-sudo-timer-${USER_NAME}-lock"
FOREVER_FILE="/etc/sudoers.d/99-sudo-forever-${USER_NAME}"
OMARCHY_FILE="/etc/sudoers.d/99-omarchy-nopasswd-${USER_NAME}"
OMARCHY_TIMER="omarchy-nopasswd-expire-${USER_NAME}"
TIMER_UNIT="sudo-timer-expire-${USER_NAME}"
STATE_FILE="/run/sudo-timer-${USER_NAME}.expires"
BOOT_UNIT_NAME="sudo-timer-boot-cleanup.service"
BOOT_UNIT="/etc/systemd/system/${BOOT_UNIT_NAME}"
WATCH_UNIT_NAME="sudo-timer-lock-watch.service"
WATCH_UNIT="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/${WATCH_UNIT_NAME}"
LOCK_DETECTOR="omarchy-hyprland-session-locked"
LOCK_POLL=${SUDO_TIMER_LOCK_POLL:-5}

assume_yes=false
# revoke_all stops the lock watcher, which is fatal when the watcher is the one
# revoking. It skips that step for itself.
in_watcher=false

# Menu choices. Non-numeric values are modes rather than durations.
choices=(
  "5 minutes|300"
  "15 minutes|900"
  "30 minutes|1800"
  "1 hour|3600"
  "6 hours|21600"
  "12 hours|43200"
  "24 hours|86400"
  "Until screen lock|lock"
  "Until reboot|reboot"
  "Forever|forever"
)

die() {
  echo "sudo-timer: $*" >&2
  exit 1
}

usage() {
  sed -n '3,13p' "$0" | sed 's/^# \{0,1\}//'
}

# "90" = minutes. Otherwise 30s / 15m / 6h, or a mode name.
parse_duration() {
  local input=${1,,}
  case $input in
    forever | inf | infinite | permanent)
      echo forever
      return 0
      ;;
    lock | locked | screenlock | until-lock)
      echo lock
      return 0
      ;;
    reboot | boot | restart | until-reboot)
      echo reboot
      return 0
      ;;
  esac
  if [[ $input =~ ^([0-9]+)$ ]]; then
    echo $((${BASH_REMATCH[1]} * 60))
  elif [[ $input =~ ^([0-9]+)s$ ]]; then
    echo "${BASH_REMATCH[1]}"
  elif [[ $input =~ ^([0-9]+)m(in)?$ ]]; then
    echo $((${BASH_REMATCH[1]} * 60))
  elif [[ $input =~ ^([0-9]+)h$ ]]; then
    echo $((${BASH_REMATCH[1]} * 3600))
  else
    return 1
  fi
}

human_duration() {
  local secs=$1
  if ((secs >= 3600)); then
    local h=$((secs / 3600)) m=$((secs % 3600 / 60))
    if ((m)); then echo "${h} h ${m} min"; else echo "${h} h"; fi
  elif ((secs >= 60)); then
    echo "$((secs / 60)) min"
  else
    echo "${secs} s"
  fi
}

# Avoids a password prompt: without cached credentials and without a NOPASSWD
# rule, the mode cannot be on anyway.
have_root_now() { sudo -n true 2>/dev/null; }

current_mode() {
  if ! have_root_now; then
    echo none
  elif sudo -n test -f "$FOREVER_FILE"; then
    echo forever
  elif sudo -n test -f "$LOCK_FILE"; then
    echo lock
  elif sudo -n test -f "$REBOOT_FILE"; then
    echo reboot
  elif sudo -n test -f "$TIMED_FILE"; then
    echo timed
  elif sudo -n test -f "$OMARCHY_FILE"; then
    echo omarchy
  else
    echo none
  fi
}

# Seconds left on our own timer, from the expiry stamp in /run.
remaining_own() {
  local expires now
  [[ -r $STATE_FILE ]] || return 1
  expires=$(<"$STATE_FILE")
  [[ $expires =~ ^[0-9]+$ ]] || return 1
  now=$(date +%s)
  ((expires > now)) || return 1
  echo $((expires - now))
}

# Seconds left on omarchy's timer, which we do not own.
remaining_omarchy() {
  local next now
  command -v jq >/dev/null || return 1
  next=$(systemctl list-timers --all --output=json 2>/dev/null |
    jq -r --arg u "${OMARCHY_TIMER}.timer" '.[] | select(.unit == $u) | .next') || return 1
  [[ $next =~ ^[0-9]+$ ]] || return 1
  now=$(date +%s)
  next=$((next / 1000000))
  ((next > now)) || return 1
  echo $((next - now))
}

stop_timer() {
  local unit=$1
  sudo systemctl stop "${unit}.timer" 2>/dev/null || true
  sudo systemctl reset-failed "${unit}.timer" "${unit}.service" 2>/dev/null || true
}

# A wall-clock timer (not --on-active): OnCalendar follows the clock and
# expires even if the machine was suspended in between.
arm_timer() {
  local secs=$1 at
  at=$(date -d "+${secs} seconds" '+%Y-%m-%d %H:%M:%S')
  stop_timer "$TIMER_UNIT"
  local out
  # systemd-run always writes two lines to stderr; only show them on failure.
  if ! out=$(sudo systemd-run \
    --on-calendar="$at" \
    --timer-property=AccuracySec=1s \
    --unit="$TIMER_UNIT" \
    /usr/bin/rm -f -- "$TIMED_FILE" "$STATE_FILE" 2>&1); then
    echo "$out" >&2
    return 1
  fi
}

# Clears every timed rule early during boot. Transient timers do not survive a
# reboot, but the drop-in file does. The glob covers the timed, reboot and lock
# files; "forever" is named differently on purpose and is spared.
ensure_boot_cleanup() {
  [[ -f $BOOT_UNIT ]] && return 0
  sudo tee "$BOOT_UNIT" >/dev/null <<UNIT
[Unit]
Description=Remove expired sudo-timer rules at boot
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target

[Service]
Type=oneshot
ExecStart=/usr/bin/find /etc/sudoers.d -maxdepth 1 -name '99-sudo-timer-*' -delete

[Install]
WantedBy=sysinit.target
UNIT
  sudo systemctl daemon-reload
  sudo systemctl enable "$BOOT_UNIT_NAME" >/dev/null 2>&1
}

# A user unit, because the lock state can only be read from inside the graphical
# session. It needs no root of its own: while the rule is in place, the sudo it
# calls to remove that rule is itself passwordless.
ensure_lock_watcher() {
  local self
  self=$(realpath "$0")
  mkdir -p "$(dirname "$WATCH_UNIT")"
  cat >"$WATCH_UNIT" <<UNIT
[Unit]
Description=Revoke passwordless sudo when the session locks

[Service]
Type=simple
ExecStart=${self} --watch-lock
UNIT
  systemctl --user daemon-reload
}

# Always validate before installing — a malformed file in /etc/sudoers.d
# can lock you out of sudo entirely.
install_rule() {
  local target=$1 tmp
  tmp=$(mktemp) || die "could not create a temporary file"
  printf '%s ALL=(ALL:ALL) NOPASSWD: ALL\n' "$USER_NAME" >"$tmp"
  if ! visudo -cf "$tmp" >/dev/null; then
    rm -f "$tmp"
    die "generated sudoers rule was rejected by visudo — nothing changed"
  fi
  sudo install -m 0440 -o root -g root "$tmp" "$target"
  rm -f "$tmp"
}

# Every route to passwordless sudo for this user, so that "off" really means
# the password is back.
revoke_all() {
  local had_omarchy=false
  sudo -n test -f "$OMARCHY_FILE" && had_omarchy=true

  # Order matters: the rule file is the only thing granting us root here, so it
  # goes last. The other way around, the remaining steps break halfway through.
  stop_timer "$TIMER_UNIT"
  $had_omarchy && stop_timer "$OMARCHY_TIMER"
  $in_watcher || systemctl --user stop "$WATCH_UNIT_NAME" 2>/dev/null || true
  sudo rm -f -- "$TIMED_FILE" "$REBOOT_FILE" "$LOCK_FILE" "$FOREVER_FILE" \
    "$OMARCHY_FILE" "$STATE_FILE"
  sudo -k

  $had_omarchy && echo "Also removed omarchy's rule ($(basename "$OMARCHY_FILE"))."
  return 0
}

confirm() {
  local prompt=$1
  $assume_yes && return 0
  [[ -t 0 ]] || die "no terminal to confirm on — run with --yes"
  if command -v gum >/dev/null; then
    gum confirm --default=false "$prompt"
  else
    local answer
    read -r -p "$prompt [y/N] " answer
    [[ ${answer,,} == y* ]]
  fi
}

warn_block() {
  local window=$1
  cat <<TXT

  ⚠  Warning
  Any process running as $USER_NAME may run anything as root without a
  password — $window. That includes scripts and agents you started.

TXT
}

cmd_status() {
  local mode secs
  mode=$(current_mode)
  case $mode in
    forever)
      echo "Passwordless sudo: ON — forever (survives a reboot)."
      echo "Turn off with: sudo-timer off"
      ;;
    lock)
      if systemctl --user is-active --quiet "$WATCH_UNIT_NAME"; then
        echo "Passwordless sudo: ON — until the screen locks, or the next reboot."
      else
        echo "Passwordless sudo: ON — until the next reboot."
        echo "The lock watcher is not running, so locking will not revoke it."
      fi
      ;;
    reboot)
      echo "Passwordless sudo: ON — until the next reboot."
      ;;
    timed)
      if secs=$(remaining_own); then
        echo "Passwordless sudo: ON — $(human_duration "$secs") left (until $(date -d "@$(($(date +%s) + secs))" '+%H:%M'))."
      else
        echo "Passwordless sudo: ON — timed, time left unknown."
      fi
      ;;
    omarchy)
      if secs=$(remaining_omarchy); then
        echo "Passwordless sudo: ON via omarchy — $(human_duration "$secs") left."
      else
        echo "Passwordless sudo: ON via omarchy."
      fi
      ;;
    none) echo "Passwordless sudo: OFF — sudo asks for a password." ;;
  esac
}

cmd_off() {
  if [[ $(current_mode) == none ]]; then
    echo "Passwordless sudo is already off."
    return 0
  fi
  revoke_all
  echo "Passwordless sudo is OFF. Sudo asks for a password again."
}

# Runs from the user unit. Exits as soon as the rule is gone, whoever removed it.
cmd_watch_lock() {
  in_watcher=true
  while sudo -n test -f "$LOCK_FILE" 2>/dev/null; do
    if "$LOCK_DETECTOR" >/dev/null 2>&1; then
      revoke_all
      return 0
    fi
    sleep "$LOCK_POLL"
  done
}

cmd_enable() {
  local spec=$1 secs window
  secs=$(parse_duration "$spec") ||
    die "could not read the duration \"$spec\" (try 15m, 6h, lock, reboot, forever)"

  case $secs in
    forever) window="until you turn it off yourself" ;;
    lock) window="until you lock the screen, or the next reboot" ;;
    reboot) window="until the next reboot" ;;
    *) window="for $(human_duration "$secs"), until $(date -d "+${secs} seconds" '+%H:%M')" ;;
  esac

  [[ $secs == lock ]] && ! command -v "$LOCK_DETECTOR" >/dev/null &&
    die "$LOCK_DETECTOR is missing — lock mode needs it to see the lock screen"

  warn_block "$window"
  confirm "Enable passwordless sudo $window?" || {
    echo "Aborted. Nothing changed."
    return 1
  }

  # Ask for the password now if needed, so the steps below are not interrupted
  # halfway. "sudo true" matches sudoers like any other command; "sudo -v" asks
  # for a password even when a NOPASSWD rule already applies.
  sudo true

  # Leaving a previous mode's file behind would outlive the new choice. Each
  # branch below installs its own rule first and only then clears the others,
  # because the old file may be the only thing granting us root right now.
  # "${stale[@]/$KEEP}" blanks the entry being kept rather than dropping it;
  # rm -f accepts the resulting empty argument and still exits 0.
  local stale=("$TIMED_FILE" "$REBOOT_FILE" "$LOCK_FILE" "$FOREVER_FILE")
  systemctl --user stop "$WATCH_UNIT_NAME" 2>/dev/null || true
  stop_timer "$TIMER_UNIT"

  case $secs in
    forever)
      install_rule "$FOREVER_FILE"
      sudo rm -f -- "${stale[@]/$FOREVER_FILE}" "$STATE_FILE"
      ;;
    reboot)
      ensure_boot_cleanup
      install_rule "$REBOOT_FILE"
      sudo rm -f -- "${stale[@]/$REBOOT_FILE}" "$STATE_FILE"
      ;;
    lock)
      ensure_boot_cleanup
      ensure_lock_watcher
      install_rule "$LOCK_FILE"
      sudo rm -f -- "${stale[@]/$LOCK_FILE}" "$STATE_FILE"
      if ! systemctl --user start "$WATCH_UNIT_NAME"; then
        sudo rm -f -- "$LOCK_FILE"
        die "could not start the lock watcher — the rule was removed again"
      fi
      ;;
    *)
      ensure_boot_cleanup
      install_rule "$TIMED_FILE"
      sudo rm -f -- "${stale[@]/$TIMED_FILE}"
      if ! arm_timer "$secs"; then
        sudo rm -f -- "$TIMED_FILE"
        die "could not schedule the expiry — the rule was removed again"
      fi
      date -d "+${secs} seconds" +%s | sudo tee "$STATE_FILE" >/dev/null
      ;;
  esac

  # Omarchy's own rule would otherwise live on with its own lifetime.
  if sudo test -f "$OMARCHY_FILE"; then
    sudo rm -f -- "$OMARCHY_FILE"
    stop_timer "$OMARCHY_TIMER"
  fi

  echo
  cmd_status
}

cmd_menu() {
  local labels=() label spec=""
  for entry in "${choices[@]}"; do labels+=("${entry%%|*}"); done

  echo
  cmd_status
  echo

  if command -v gum >/dev/null && [[ -t 0 ]]; then
    label=$(gum choose --header="Passwordless sudo for how long?" "${labels[@]}" "Turn off now" "Cancel") || return 1
  else
    PS3="Choose [1-$((${#labels[@]} + 2))]: "
    select label in "${labels[@]}" "Turn off now" "Cancel"; do
      [[ -n ${label:-} ]] && break
    done
  fi

  case ${label:-Cancel} in
    Cancel | "") echo "Aborted."; return 0 ;;
    "Turn off now") cmd_off; return 0 ;;
  esac

  for entry in "${choices[@]}"; do
    if [[ ${entry%%|*} == "$label" ]]; then spec=${entry##*|}; fi
  done
  # Numeric choices are seconds; the named modes pass through untouched.
  [[ $spec =~ ^[0-9]+$ ]] && spec="${spec}s"
  cmd_enable "$spec"
}

main() {
  local args=()
  while (($#)); do
    case $1 in
      -y | --yes) assume_yes=true ;;
      --watch-lock) args+=("__watch_lock") ;;
      -h | --help)
        usage
        return 0
        ;;
      *) args+=("$1") ;;
    esac
    shift
  done

  case ${args[0]:-menu} in
    menu) cmd_menu ;;
    status | -s) cmd_status ;;
    off | revoke | disable) cmd_off ;;
    __watch_lock) cmd_watch_lock ;;
    *) cmd_enable "${args[0]}" ;;
  esac
}

main "$@"
